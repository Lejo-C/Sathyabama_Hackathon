# Copy to backend/.env and fill in. Never commit the real .env.

# Groq is used ONLY to phrase the finished report in plain English. Scoring is
# deterministic and never touches the LLM. With no key set, the service falls
# back to a template summary and keeps working.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Extra CORS origins (comma separated). localhost:5173 (Vite) is allowed already.
CORS_ALLOW_ORIGINS=

# DEBUG / INFO / WARNING
LOG_LEVEL=INFO
